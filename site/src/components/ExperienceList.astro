---
import { experience } from '../data/experience';
---
<div class="experience" data-experience>
  <div class="experience__viewport" data-experience-viewport tabindex="0" role="region" aria-label="Professional experience, newest first. Scroll to explore.">
    <ol class="experience__list" data-experience-list>
      {experience.map(({ year, company, role }) => (
        <li class="experience__row">
          <span class="experience__year"><span class="sr-only">Started in </span>{year}</span>
          <span class="experience__company">{company}</span>
          <span class="experience__role">{role}</span>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .experience { min-width: 0; align-self: start; position: relative; }
  .experience__viewport { height: 15rem; overflow-y: auto; overflow-anchor: none; overscroll-behavior-y: contain; scrollbar-width: none; padding-block: 1.5rem; mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent); -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent); }
  .experience__viewport::-webkit-scrollbar { display: none; }
  .experience__list { list-style: none; padding: 0; margin: 0; }
  .experience__row { display: grid; grid-template-columns: 2.75rem 8rem minmax(0, 1fr); gap: .8rem; align-items: baseline; min-height: 2.5rem; padding-block: .35rem; font-size: .875rem; line-height: 1.5; }
  .experience__year { font-family: var(--mono); font-size: .8125rem; color: #6b7681; }
  .experience__company { color: var(--text); font-weight: 500; }
  .experience__role { color: #6b7681; }
  @media (min-width: 1024px) {
    /* Let the heading determine the grid row height and both fade boundaries. */
    .experience { align-self: stretch; }
    .experience__viewport { position: absolute; inset: 0; height: 100%; }
  }
  @media (max-width: 767px) {
    .experience__row { grid-template-columns: 2.3rem 6.3rem minmax(0, 1fr); gap: .5rem; font-size: .8125rem; }
    .experience__year { font-size: .75rem; }
  }
</style>
