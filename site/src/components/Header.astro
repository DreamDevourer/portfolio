---
import { site } from '../data/site';
const { current = '' } = Astro.props;
const links = [
  { href: '/#professional-projects', label: 'Work', current: 'work' },
  { href: '/aboutme.html', label: 'About', current: 'about' },
  { href: site.marketplace, label: 'Marketplace', current: 'marketplace', external: true },
];
---
<header class="site-header" data-docked="false">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="Nicolas Mendes home"><img src="/static/redesign/capital-fox.svg" alt="Capital Fox" width="162" height="35" /></a>
    <details class="site-nav" id="site-nav" open>
      <summary class="nav-toggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="Primary navigation">
      <div class="nav">
        {links.map((link) => <a href={link.href} aria-current={current === link.current ? 'page' : undefined} data-external={link.external ? '' : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}</a>)}
      </div>
      </nav>
    </details>
    <a class="social-link" href={site.linkedin} target="_blank" rel="noreferrer" aria-label="Visit Nicolas Mendes on LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.35 3.5a1.85 1.85 0 1 1 0 3.7 1.85 1.85 0 0 1 0-3.7ZM3.75 8.65h3.2v11.1h-3.2V8.65Zm5.2 0h3.06v1.52h.04c.43-.8 1.47-1.65 3.02-1.65 3.23 0 3.83 2.12 3.83 4.88v6.35h-3.2v-5.63c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.16 1.46-2.16 2.97v5.72h-3.2V8.65Z" /></svg>
    </a>
  </div>
</header>
