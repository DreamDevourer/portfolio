---
import media from '../data/media.json';
import type { CaseStudyGalleryItem } from '../data/types';
const { items, title } = Astro.props as { items: CaseStudyGalleryItem[]; title: string };
---
<section class="case-gallery" data-case-gallery aria-label={`${title} selected screens`}>
  <div class="case-gallery__track" data-gallery-track tabindex="0" aria-label={`${title} screens. Hover to pause and scroll manually.`}>
    {items.map(({ source, alt }) => {
      const item = media[source as keyof typeof media];
      if (!item) throw new Error(`Missing prepared gallery media: ${source}`);
      return <figure class="case-gallery__slide" data-gallery-slide>
        <a href={item.src} data-enlarge aria-label={`Enlarge: ${alt}`} data-cursor="image">
          <img src={item.src} srcset={item.srcset} sizes="(min-width: 1024px) 70vw, 86vw" width={item.width} height={item.height} alt={alt} loading="lazy" decoding="async" />
        </a>
      </figure>;
    })}
  </div>
</section>
