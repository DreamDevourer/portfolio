    "type": "git",
    "url": "git+https://github.com/DreamDevourer/portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/DreamDevourer/portfolio/issues"
  },
  "homepage": "https://github.com/DreamDevourer/portfolio#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "cheerio": "^1.2.0",
    "gulp": "^5.0.0",
    "lighthouse": "^13.4.1"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.1",
    "sass": "^1.80.3",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
