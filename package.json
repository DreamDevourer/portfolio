{
  "name": "static-portfolio-nick-gen2",
  "version": "3.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && cd site && astro dev",
    "check": "cd site && astro check",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build:stage": "node scripts/build.mjs --stage-only",
    "build": "node scripts/build.mjs",
    "preview": "cd site && astro preview --host 127.0.0.1",
    "check:output": "node scripts/check-output.mjs",
    "test:unit": "node --test tests/publish.test.mjs tests/validate-output.test.mjs",
    "test:e2e": "playwright test tests/site.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test": "npm run check && npm run test:unit && npm run build:stage && npm run test:e2e && npm run test:a11y"
  },
